63:source "${CLAUDE_PLUGIN_ROOT}/engine/lib/risk.sh"
64:LINES=$(diff_signals "$BASE" HEAD /tmp/promo-files /tmp/promo-added)
65:deterministic_risk harness/harness.config.json "$LINES" /tmp/promo-files /tmp/promo-added
