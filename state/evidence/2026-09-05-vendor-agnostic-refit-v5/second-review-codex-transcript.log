 function Get-PromotionDecision {
   param($Config, [string]$Environment,
         [string]$DeterministicTier, [string]$ClassifierTier,
-        [bool]$GateGreen = $false, [bool]$ReviewShip = $false, [bool]$E2EEvidence = $false)
