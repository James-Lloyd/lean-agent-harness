1:#!/usr/bin/env bash
2:# risk.sh ? risk classification for gated promotion (bash mirror of risk.ps1).
3:#
4:# Decides how much HUMAN scrutiny an already-green, already-reviewed diff needs before it is merged
5:# onward. It does not decide correctness ? the gate and the fresh-context reviewer already did.
6:#
7:# Three invariants, enforced in code rather than trusted from a prompt:
8:#  1. ESCALATE-ONLY  ? every stage may raise a tier, none may lower it (risk_tier_max is a max()
9:#     over LOW<MEDIUM<HIGH). A change's author cannot classify its own change as low-risk.
10:#  2. FAIL-CLOSED    ? unparseable / unknown / absent / empty all resolve to HIGH / HUMAN.
11:#  3. PROD IS NEVER AUTOMATED ? promotion_decision refuses prod AUTO before reading any config.
12:#
13:# Twin rule: a change lands in risk.ps1 and risk.sh or not at all.
14:
15:# Paths whose change governs the promotion policy ITSELF, or the guardrails it leans on. HARDCODED,
16:# deliberately not config-driven: if the escalation list for "edits to the escalation list" lived in
17:# config, one edit could disarm the mechanism and then auto-merge itself. Keep byte-identical with
18:# $script:RiskSelfGovernGlobs in risk.ps1.
19:RISK_SELF_GOVERN_GLOBS='specs/**
20:harness/harness.config.json
21:.claude/settings.json
22:.claude/hooks/**
23:.github/workflows/**
24:plugin/hooks/**
25:plugin/engine/lib/risk.ps1
26:plugin/engine/lib/risk.sh
27:plugin/agents/risk-classifier.md
28:plugin/commands/promote.md
29:plugin/skills/risk-tiering/**'
30:
31:# Read config through jq with CR stripped. NOT cosmetic: jq.exe under Git Bash on Windows emits
32:# CRLF, so a glob read straight out of jq arrives as "**/payments/**\r", compiles to a regex ending
33:# `.*\r$`, and then silently matches NOTHING. Every rule in this file would fail OPEN ? the exact
34:# direction a risk classifier must never fail. Route every config read through here.
35:risk_jq() {  # same args as jq
36:  jq "$@" 2>/dev/null | tr -d '\r' || true
37:}
38:
39:# Strip a trailing CR from a value read line-by-line (same hazard as risk_jq, for `read` loops).
40:strip_cr() { printf '%s' "${1%$'\r'}"; }
41:
42:# Translate a path glob to an anchored ERE with the SAME semantics as the PS twin (PowerShell -like
43:# has no `**`, and bash `case` globs cross `/` differently ? so neither native mechanism is used).
44:# `**/` spans zero or more whole segments, `**` spans anything, `*` and `?` never cross `/`.
45:# Expansion goes through placeholders because the replacements themselves contain `*` and `/`, and a
46:# naive sequential sed would re-process its own output. Mirror of Convert-GlobToRegex in risk.ps1.
47:glob_to_regex() {  # $1 glob ; echoes an anchored ERE
48:  printf '%s' "$1" | sed \
49:    -e 's|\\|/|g' \
50:    -e 's/[.+^$(){}|]/\\&/g' -e 's/\[/\\[/g' -e 's/\]/\\]/g' \
51:    -e 's|\*\*/|@@RA@@|g' -e 's|\*\*|@@RB@@|g' -e 's|\*|@@RC@@|g' -e 's|?|@@RD@@|g' \
52:    -e 's|@@RA@@|(.*/)?|g' -e 's|@@RB@@|.*|g' \
53:    -e 's|@@RC@@|[^/]*|g'  -e 's|@@RD@@|[^/]|g' \
54:    -e 's|^|^|' -e 's|$|$|'
55:}
56:
57:# Compile a whole glob SET to ONE alternation regex. Compiling per-glob-per-file instead costs a sed
58:# + a grep fork for every (file, glob) pair: a real 57-file promotion diff against the shipped
59:# criteria is ~2800 pairs / ~5600 forks, which took MINUTES on Windows and made /promote unusable.
60:# Compile once per rule group, match in one pass. Mirror of Get-GlobUnionRegex in risk.ps1.
61:globs_union_regex() {  # $1 newline-separated globs ; echoes an ERE alternation, or "" if none
62:  local g out=""
63:  while IFS= read -r g; do
64:    g="$(strip_cr "$g")"
65:    [ -n "$g" ] || continue
66:    if [ -n "$out" ]; then out="$out|$(glob_to_regex "$g")"; else out="$(glob_to_regex "$g")"; fi
67:  done <<EOF
68:$1
69:EOF
70:  printf '%s' "$out"
71:}
72:
73:# Normalize a repo-relative path for matching: backslashes to forward, and strip a LEADING './' only
74:# ? never a character-class trim, which would eat the dot of '.github/...' and silently unmatch it.
75:normalize_path() {  # $1 path
76:  local p
77:  p="$(printf '%s' "$1" | tr '\\' '/')"
78:  while case "$p" in ./*) true ;; *) false ;; esac; do p="${p#./}"; done
79:  printf '%s' "$p"
80:}
81:
82:# Does a repo-relative path match ANY of the newline-separated globs on $2? Returns 0 on match.
83:# Mirror of Test-PathMatchesAny in risk.ps1.
84:path_matches_any() {  # $1 path  $2 newline-separated globs
85:  local p rx
86:  [ -n "$1" ] || return 1
87:  rx="$(globs_union_regex "$2")"
88:  [ -n "$rx" ] || return 1
89:  p="$(normalize_path "$1")"
90:  printf '%s' "$p" | grep -qiE "$rx"
91:}
92:
93:# Echo every path in the (already normalized) file list $1 that matches ANY glob in $2. One grep for
94:# the whole group ? this is the hot path that keeps /promote fast on a real diff.
95:paths_matching() {  # $1 normalized-files-file  $2 newline-separated globs
96:  local rx
97:  rx="$(globs_union_regex "$2")"
98:  [ -n "$rx" ] || return 0
99:  grep -iE "$rx" "$1" 2>/dev/null || true
100:}
101:
102:# Rank a tier: LOW=0 MEDIUM=1 HIGH=2. Anything unrecognized ranks HIGH ? an unknown tier is not a
103:# low one. Mirror of Get-RiskRank in risk.ps1.
104:risk_rank() {  # $1 tier ; echoes 0|1|2
105:  # TRIM, never delete interior whitespace -- "L OW" must not collapse to LOW (the PS twin's .Trim()
106:  # leaves it unrecognized, which ranks HIGH; deleting would have ranked it 0).
107:  case "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" in
108:    LOW)    echo 0 ;;
109:    MEDIUM) echo 1 ;;
110:    HIGH)   echo 2 ;;
111:    *)      echo 2 ;;
112:  esac
113:}
114:
115:# The escalate-only ratchet, in code: echo the HIGHER of two tiers. This is what makes "the agent may
116:# confirm or raise, never lower" a property of the system rather than a promise in a prompt.
117:# Mirror of Merge-RiskTier in risk.ps1.
118:risk_tier_max() {  # $1 tier  $2 tier ; echoes LOW|MEDIUM|HIGH
119:  local a b hi
120:  a="$(risk_rank "$1")"; b="$(risk_rank "$2")"
121:  if [ "$a" -ge "$b" ]; then hi="$a"; else hi="$b"; fi
122:  case "$hi" in 0) echo LOW ;; 1) echo MEDIUM ;; *) echo HIGH ;; esac
123:}
124:
125:# Parse the risk-classifier agent's verdict from stdin: echoes LOW | MEDIUM | HIGH. Mirrors
126:# review_verdict's fail-closed last-line rule ? only the LAST line STARTING with RISK: counts, so a
127:# mid-reasoning "RISK: LOW would be wrong here" cannot decide the outcome. Any other outcome (no
128:# text, no RISK: line, an unrecognized token) is HIGH, not a neutral value: the safe direction is
129:# more human attention, not less. Mirror of Get-RiskVerdict in risk.ps1.
130:risk_verdict() {
131:  local line
132:  line="$(grep -E '^[[:space:]]*RISK:' | tail -1 || true)"
133:  if printf '%s' "$line" | grep -qE '^[[:space:]]*RISK:[[:space:]]*LOW([[:space:]]|$)'; then echo LOW
134:  elif printf '%s' "$line" | grep -qE '^[[:space:]]*RISK:[[:space:]]*MEDIUM([[:space:]]|$)'; then echo MEDIUM
135:  else echo HIGH; fi
136:}
137:
138:# Money-signal match against added-diff TEXT (content, not paths): the term must start a word, with
139:# NO constraint on what follows. NOT \b ? BSD grep has no \b and the twins must agree character for
140:# character, so both emulate the boundary with an explicit class.
141:#
142:# Leading boundary only, and `_` counts as a separator (class is [^A-Za-z0-9], not [^A-Za-z0-9_]).
143:# Deliberate: an earlier trailing-boundary version was wrong in the DANGEROUS direction, missing
144:# `tax_rate`, `taxes`, `prices`, `amounts` ? inflected and snake_case forms are most of how money
145:# words appear in code, so it silently passed real money diffs as LOW. The cost is a false positive
146:# on a word that merely STARTS with a money term (`taxonomy`, `balancer`); a false HIGH costs one
147:# human glance, a false LOW auto-merges a money bug. Mid-word (`syntax` for `tax`) still does not fire.
148:# Mirror of Test-MoneySignal in risk.ps1.
149:money_signal() {  # $1 text  $2 term ; returns 0 if present
150:  local text="$1" term="$2" esc
151:  [ -n "$text" ] && [ -n "$term" ] || return 1
152:  esc="$(printf '%s' "$term" | sed -e 's/[.[\*^$()+?{}|\\]/\\&/g' -e 's/\]/\\]/g')"
153:  printf '%s' "$text" | grep -qiE "(^|[^A-Za-z0-9])${esc}"
154:}
155:
156:# The deterministic classifier ? stage 1, and the only stage that can produce LOW. Every criterion is
157:# computed FROM THE DIFF, so it cannot be talked around. Each rule can only raise the tier, so the
158:# order below affects the reason list, never the result.
159:#   $1 config path   $2 changed lines   $3 file holding changed paths (one per line)
160:#   $4 file holding the ADDED diff lines (may be /dev/null)
161:# Echoes "TIER|reason; reason; ...". Mirror of Get-DeterministicRisk in risk.ps1.
162:deterministic_risk() {
163:  local config="$1" changed="${2:-0}" files_file="$3" added_file="${4:-/dev/null}"
164:  local tier=LOW reasons="" files added f term cat maxlines cats catglobs
165:  # ${2:-0} covers an ABSENT arg but not an empty-string one, and every compare below is arithmetic.
166:  case "$changed" in ''|*[!0-9]*) changed=0 ;; esac
167:  files="$(grep -v '^[[:space:]]*$' "$files_file" 2>/dev/null | tr -d '
168:' || true)"
169:  added="$(cat "$added_file" 2>/dev/null || true)"
170:
171:  # Fail-closed: nothing to classify is not "low risk", it is a caller bug or a range resolved wrong.
172:  if [ -z "$files" ] && [ "$changed" -le 0 ]; then
173:    # ASCII-only inside emitted STRINGS (comments are fine) -- twin parity: PS 5.1 reads a BOM-less
174:    # .ps1 as ANSI, so a non-ASCII literal would reach the audit record as mojibake there.
175:    echo "HIGH|empty diff - nothing to classify (fail-closed)"; return
176:  fi
177:
178:  # Normalize ONCE, then run one grep per rule group over the whole list (see paths_matching).
179:  local nf; nf="$(mktemp)"
180:  while IFS= read -r f; do
181:    f="$(strip_cr "$f")"; [ -n "$f" ] || continue
182:    normalize_path "$f"; echo
183:  done <<EOF > "$nf"
184:$files
185:EOF
186:
187:  while IFS= read -r f; do
188:    [ -n "$f" ] || continue
189:    tier="$(risk_tier_max "$tier" HIGH)"
190:    reasons="${reasons}self-governance: $f (policy, guardrails, or CI); "
191:  done <<EOF
192:$(paths_matching "$nf" "$RISK_SELF_GOVERN_GLOBS")
193:EOF
194:
195:  local always
196:  always="$(risk_jq -r '.promotion.alwaysHuman[]? // empty' "$config")"
197:  while IFS= read -r f; do
198:    [ -n "$f" ] || continue
199:    tier="$(risk_tier_max "$tier" HIGH)"
200:    reasons="${reasons}alwaysHuman path: $f; "
201:  done <<EOF
202:$(paths_matching "$nf" "$always")
203:EOF
204:
205:  while IFS= read -r term; do
206:    term="$(strip_cr "$term")"; [ -n "$term" ] || continue
207:    if money_signal "$added" "$term"; then
208:      tier="$(risk_tier_max "$tier" HIGH)"
209:      reasons="${reasons}money signal '$term' in added lines; "
210:    fi
211:  done <<EOF
212:$(risk_jq -r '.promotion.moneySignals[]? // empty' "$config")
213:EOF
214:
215:  maxlines="$(risk_jq -r '.promotion.criteria.maxChangedLines // empty' "$config")"
216:  if [ -n "$maxlines" ] && [ "$changed" -ge "$maxlines" ]; then
217:    tier="$(risk_tier_max "$tier" MEDIUM)"
218:    reasons="${reasons}$changed changed lines (limit $maxlines); "
219:  fi
220:
221:  cats="$(risk_jq -r '.promotion.criteria.escalatePaths // {} | keys[]?' "$config")"
222:  while IFS= read -r cat; do
223:    cat="$(strip_cr "$cat")"; [ -n "$cat" ] || continue
224:    catglobs="$(risk_jq -r --arg c "$cat" '.promotion.criteria.escalatePaths[$c][]? // empty' "$config")"
225:    # First match only: the category is the finding, not each file in it.
226:    f="$(paths_matching "$nf" "$catglobs" | head -1)"
227:    if [ -n "$f" ]; then
228:      tier="$(risk_tier_max "$tier" MEDIUM)"
229:      reasons="${reasons}$cat: $f; "
230:    fi
231:  done <<EOF
232:$cats
233:EOF
234:  rm -f "$nf"
235:
236:  [ -n "$reasons" ] || reasons="no escalation criterion tripped"
237:  echo "${tier}|${reasons%"; "}"
238:}
239:
240:# Shape-validate the promotion block before ANY of it is trusted. Without this, every degenerate
241:# shape SKIPS a rule instead of escalating -- the block fails OPEN, contradicting this file's own
242:# fail-closed contract. Real cases that reached AUTO before this gate existed: `preconditions` absent
243:# entirely (schema-valid; /harness-prune may trim it) so a red gate + no review SHIP + no e2e evidence
244:# all passed while the audit string still read "all preconditions met"; and `alwaysHuman`/`moneySignals`
245:# written as a SCALAR instead of an array (a plausible hand-edit), which made the whole money rule
246:# evaluate to "no match" so a payments diff classified LOW.
247:# Echoes "" when well-formed, else a reason. Mirror of Test-PromotionConfigShape in risk.ps1.
248:promotion_config_shape() {  # $1 config path
249:  local config="$1" k t n
250:  if [ "$(risk_jq -r 'has("promotion")' "$config")" != "true" ]; then
251:    echo "promotion block is absent"; return
252:  fi
253:  t="$(risk_jq -r '.promotion.enabled | type' "$config")"
254:  if [ "$t" != "boolean" ]; then
255:    echo "promotion.enabled is not a boolean (got type '$t')"; return
256:  fi
257:  for k in alwaysHuman moneySignals; do
258:    t="$(risk_jq -r --arg k "$k" '.promotion[$k] | type' "$config")"
259:    if [ "$t" = "null" ]; then echo "promotion.$k is absent"; return; fi
260:    if [ "$t" != "array" ]; then echo "promotion.$k is not an array"; return; fi
261:    n="$(risk_jq -r --arg k "$k" '.promotion[$k] | length' "$config")"
262:    if [ "$n" = "0" ]; then echo "promotion.$k is empty"; return; fi
263:  done
264:  t="$(risk_jq -r '.promotion.preconditions | type' "$config")"
265:  if [ "$t" != "object" ]; then echo "promotion.preconditions is absent"; return; fi
266:  for k in gateGreen reviewShip e2eEvidence; do
267:    t="$(risk_jq -r --arg k "$k" '.promotion.preconditions[$k] | type' "$config")"
268:    if [ "$t" = "null" ]; then echo "promotion.preconditions.$k is absent"; return; fi
269:    if [ "$t" != "boolean" ]; then echo "promotion.preconditions.$k is not a boolean"; return; fi
270:  done
271:  # Both twins compare maxChangedLines arithmetically; a float diverges across shells, and in bash the
272:  # compare errors out and SILENTLY SKIPS the size rule.
273:  t="$(risk_jq -r '.promotion.criteria.maxChangedLines | type' "$config")"
274:  if [ "$t" = "number" ]; then
275:    if [ "$(risk_jq -r '(.promotion.criteria.maxChangedLines | floor) == .promotion.criteria.maxChangedLines' "$config")" != "true" ]; then
276:      echo "promotion.criteria.maxChangedLines is not an integer"; return
277:    fi
278:  elif [ "$t" != "null" ]; then
279:    echo "promotion.criteria.maxChangedLines is not an integer (got type '$t')"; return
280:  fi
281:  echo ""
282:}
283:
284:# The promotion decision ? AUTO (auto-approve + auto-merge) or HUMAN (escalate, never merge).
285:# Fail-closed and ordered so the strongest refusals come first, BEFORE any config is consulted: the
286:# prod refusal does not read promotion.prod.autoMerge at all. The schema's `const: false` protects a
287:# repo that validates its config in CI; this line protects the ones that do not.
288:#   $1 config path  $2 env  $3 deterministicTier  $4 classifierTier
289:#   $5 gateGreen(1/0)  $6 reviewShip(1/0)  $7 e2eEvidence(1/0)  $8 reviewerConfigured(1/0)
290:# Takes the deterministic tier AND the classifier's verdict SEPARATELY and computes their max()
291:# itself (the escalate-only merge) so a caller cannot substitute a single hand-picked tier.
292:# Echoes "AUTO|reason" or "HUMAN|reason". Mirror of Get-PromotionDecision in risk.ps1.
293:promotion_decision() {
294:  local config="$1" envname="$2" dtier="$3" ctier="$4" gate="${5:-0}" ship="${6:-0}" e2e="${7:-0}" reviewer="${8:-0}"
295:  local t enabled pre_gate pre_ship pre_e2e threshold
296:  # TRIM, never `tr -d '[:space:]'`: deleting INTERIOR whitespace made "st aging" match staging in
297:  # bash while the PS twin's .Trim() correctly rejected it as an unknown environment.
298:  envname="$(printf '%s' "$envname" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
299:  # The escalate-only merge lives HERE, not in the caller: max() the two tiers so no caller can hand
300:  # a single pre-merged (lower) tier and bypass the classifier. Either input unknown/absent ranks
301:  # HIGH (risk_rank default, via risk_tier_max), so a garbage or omitted classifier tier fails CLOSED
302:  # to HUMAN. risk_tier_max already emits canonical LOW|MEDIUM|HIGH, mirroring the PS twin's
303:  # `Merge-RiskTier` ? no rank round-trip needed.
304:  t="$(risk_tier_max "$dtier" "$ctier")"
305:
306:  if [ "$envname" != "staging" ] && [ "$envname" != "prod" ]; then
307:    echo "HUMAN|unknown environment '$2'"; return
308:  fi
309:  if [ "$envname" = "prod" ]; then
310:    echo "HUMAN|prod promotion is always a human action"; return
311:  fi
312:
313:  # Shape gate BEFORE any rule is trusted: a malformed block must refuse, never skip a rule.
314:  local shape_err; shape_err="$(promotion_config_shape "$config")"
315:  if [ -n "$shape_err" ]; then
316:    echo "HUMAN|promotion config not well-formed: $shape_err"; return
317:  fi
318:
319:  enabled="$(risk_jq -r '.promotion.enabled // false' "$config")"
320:  if [ "$enabled" != "true" ]; then
321:    echo "HUMAN|promotion.enabled is not true (report-only)"; return
322:  fi
323:
324:  # Preconditions gate the AUTO path but are not risk: a HIGH-risk change and an unreviewed change
325:  # both go to a human for different reasons, and the audit record must say which.
326:  pre_gate="$(risk_jq -r '.promotion.preconditions.gateGreen // false' "$config")"
327:  pre_ship="$(risk_jq -r '.promotion.preconditions.reviewShip // false' "$config")"
328:  pre_e2e="$(risk_jq -r '.promotion.preconditions.e2eEvidence // false' "$config")"
329:  if [ "$pre_gate" = "true" ] && [ "$gate" != "1" ]; then
330:    echo "HUMAN|precondition unmet: project gate is not green"; return
331:  fi
332:  if [ "$pre_ship" = "true" ] && [ "$ship" != "1" ]; then
333:    echo "HUMAN|precondition unmet: no fresh-context review SHIP for this range"; return
334:  fi
335:  if [ "$pre_e2e" = "true" ] && [ "$e2e" != "1" ]; then
336:    echo "HUMAN|precondition unmet: no end-to-end evidence for this range"; return
337:  fi
338:
339:  threshold="$(risk_jq -r '.promotion.staging.autoMergeAtOrBelow // "" ' "$config")"
340:  threshold="$(printf '%s' "$threshold" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
341:  if [ "$threshold" != "low" ]; then
342:    echo "HUMAN|staging.autoMergeAtOrBelow is not \"low\" (report-only)"; return
343:  fi
344:  if [ "$t" != "LOW" ]; then
345:    echo "HUMAN|risk tier $t exceeds the staging auto-merge threshold"; return
346:  fi
347:  # Last gate before AUTO, and fail-closed by default (0): GitHub rejects self-approval, so the
348:  # auto-merge is only reachable when a SEPARATE reviewer identity is available to approve the PR. The
349:  # caller (/promote) computes this from promotion.reviewer.tokenEnv -> a non-empty token whose gh
350:  # identity differs from the PR author; it CANNOT be derived here (env + gh are the caller's), so an
351:  # omitted/unresolvable reviewer arrives as 0 and drops to HUMAN, never to the merge path.
352:  if [ "$reviewer" != "1" ]; then
353:    echo "HUMAN|no separate reviewer identity configured (promotion.reviewer.tokenEnv unset/empty or equals the PR author); GitHub rejects self-approval"; return
354:  fi
355:  echo "AUTO|LOW risk, all preconditions met, separate reviewer identity available, target staging"
356:}
357:
358:# Collect the raw diff signals for a range. Thin by design ? everything decision-shaped lives in the
359:# pure functions above so the self-tests can drive them without a git fixture. Writes the changed
360:# paths to $3 and the ADDED lines (leading '+' stripped, '+++' headers excluded ? else every diff
361:# would "contain" its own paths and money-signal on them) to $4; echoes the changed-line count.
362:# Mirror of Get-DiffSignals in risk.ps1.
363:diff_signals() {  # $1 base  $2 head  $3 out-files-path  $4 out-added-path ; echoes changed lines
364:  local base="$1" head="${2:-HEAD}" out_files="$3" out_added="$4"
365:  git diff --name-only "$base" "$head" 2>/dev/null > "$out_files" || true
366:  git diff --unified=0 "$base" "$head" 2>/dev/null \
367:    | grep -E '^\+' | grep -vE '^\+\+\+' | sed -e 's/^+//' > "$out_added" || true
368:  # '-' in a numstat column means a binary file: no line count to add, but the file still counts.
369:  git diff --numstat "$base" "$head" 2>/dev/null \
370:    | awk -F'\t' '{ if ($1 ~ /^[0-9]+$/) s += $1; if ($2 ~ /^[0-9]+$/) s += $2 } END { print s + 0 }'
371:}
1:<#
2:  risk.ps1 ? risk classification for gated promotion (staging / prod).
3:
4:  What this file is for: deciding how much human scrutiny a already-green, already-reviewed diff
5:  needs before it is merged onward. It does NOT decide whether the change is correct ? the gate and
6:  the fresh-context reviewer already did that. It decides whether a human must look.
7:
8:  Three invariants, all enforced in CODE here rather than trusted from a prompt:
9:
10:   1. ESCALATE-ONLY. Every stage may RAISE a tier and none may lower it (Merge-RiskTier is a max()
11:      over LOW<MEDIUM<HIGH). The deterministic rules below run first; the risk-classifier agent runs
12:      second and is merged, never substituted. A change's author ? human or agent ? cannot classify
13:      its own change as low-risk.
14:   2. FAIL-CLOSED. Anything unparseable, unknown, absent, or empty resolves to HIGH / HUMAN. An
15:      unrecognized tier string is HIGH. An empty diff is HIGH. A missing verdict line is HIGH.
16:   3. PROD IS NEVER AUTOMATED. Get-PromotionDecision refuses a prod AUTO before it reads any config
17:      at all. The schema also pins promotion.prod.autoMerge to const false, but that only helps a
18:      repo that validates its config ? this check helps every repo.
19:
20:  Mirror of risk.sh. Twin rule applies: a change lands in both or not at all.
21:#>
22:
23:# StrictMode-safe property access (a promotion block may legitimately omit keys, and /harness-prune
24:# may trim config). Named distinctly from gate.ps1's Get-Prop so sourcing both is never a clash.
25:function Get-RiskProp($obj, [string]$name) {
26:  if ($null -eq $obj) { return $null }
27:  $p = $obj.PSObject.Properties[$name]
28:  if ($p) { return $p.Value } else { return $null }
29:}
30:
31:# Type/shape PREDICATES over a property. These return a bool or an int, never the value itself, and
32:# that is the whole point: PowerShell UNROLLS an array returned from a function, so a single-element
33:# `alwaysHuman: ["**/payments/**"]` arrives at the caller as a bare String and a `-is [Array]` test
34:# rejects a perfectly legal config. (`return ,$value` is the usual dodge but it survives assignment
35:# and NOT an inline `@(f ...)`; an ArrayList round-trip does not help either, because the unroll
36:# happens on the function's OUTPUT. Never returning the value sidesteps all of it.)
37:function Test-RiskPropPresent($obj, [string]$name) {
38:  if ($null -eq $obj) { return $false }
39:  $p = $obj.PSObject.Properties[$name]
40:  return ($p -and $null -ne $p.Value)
41:}
42:function Test-RiskPropIsArray($obj, [string]$name) {
43:  if ($null -eq $obj) { return $false }
44:  $p = $obj.PSObject.Properties[$name]
45:  if (-not $p) { return $false }
46:  return ($p.Value -is [System.Collections.IEnumerable] -and $p.Value -isnot [string])
47:}
48:function Get-RiskPropCount($obj, [string]$name) {
49:  if ($null -eq $obj) { return 0 }
50:  $p = $obj.PSObject.Properties[$name]
51:  if (-not $p -or $null -eq $p.Value) { return 0 }
52:  return @($p.Value).Count
53:}
54:# Integral-VALUE test, deliberately not a concrete .NET TYPE test. ConvertFrom-Json returns Int32
55:# under Windows PowerShell 5.1 and Int64 under pwsh, so `-is [int]` rejected a perfectly valid
56:# `maxChangedLines: 1000` on pwsh only -- caught by CI, which runs both hosts. Mirrors the sh twin,
57:# which asks jq whether `floor == value` rather than inspecting a type name.
58:function Test-RiskPropIsInteger($obj, [string]$name) {
59:  if ($null -eq $obj) { return $false }
60:  $p = $obj.PSObject.Properties[$name]
61:  if (-not $p -or $null -eq $p.Value) { return $false }
62:  $v = $p.Value
63:  if ($v -is [bool] -or $v -is [string]) { return $false }
64:  try { $d = [double]$v } catch { return $false }
65:  return ([Math]::Floor($d) -eq $d)
66:}
67:function Test-RiskPropIsBool($obj, [string]$name) {
68:  if ($null -eq $obj) { return $false }
69:  $p = $obj.PSObject.Properties[$name]
70:  if (-not $p) { return $false }
71:  return ($p.Value -is [bool])
72:}
73:
74:# Paths whose change governs the promotion policy ITSELF, or the guardrails the policy leans on.
75:# HARDCODED, deliberately not config-driven: if the escalation list for "edits to the escalation
76:# list" were itself in config, one edit could disarm the whole mechanism and then auto-merge itself.
77:# Ona's governance point ("changes to the evaluation logic, criteria, or review prompt require
78:# explicit approval") expressed as code. Repo-relative, forward slashes.
79:$script:RiskSelfGovernGlobs = @(
80:  'specs/**',                          # the immutable contract
81:  'harness/harness.config.json',       # the gate, the routing, and this policy
82:  '.claude/settings.json',             # permissions + guard hooks
83:  '.claude/hooks/**',
84:  '.github/workflows/**',              # CI can bypass every other gate
85:  'plugin/hooks/**',
86:  'plugin/engine/lib/risk.ps1',
87:  'plugin/engine/lib/risk.sh',
88:  'plugin/agents/risk-classifier.md',
89:  'plugin/commands/promote.md',
90:  'plugin/skills/risk-tiering/**'
91:)
92:
93:# Translate a path glob to an anchored regex, with the SAME semantics on both runners (PowerShell's
94:# -like has no `**`, and bash `case` globs cross `/` differently ? so neither native mechanism is
95:# used). Rules: `**/` spans zero or more whole segments, `**` spans anything, `*` and `?` never
96:# cross `/`. Matching is case-insensitive and whole-path.
97:# Expansion goes through placeholders because the replacements themselves contain `*` and `/` ? a
98:# naive sequential replace would re-process its own output. Mirror of glob_to_regex in risk.sh.
99:function Convert-GlobToRegex([string]$Glob) {
100:  # NB: `[char]1`, not a `u{0001}` escape ? the latter is PowerShell 6+ and this engine's primary
101:  # Windows runtime is 5.1, where it is a parse error for the whole file.
102:  $ph = [string][char]1
103:  $g = ("$Glob").Replace('\', '/')
104:  $g = $g -replace '([\\.+()\[\]{}^$|])', '\$1'   # escape regex metachars, but NOT * or ?
105:  $g = $g.Replace('**/', "${ph}A")                # order matters: longest token first
106:  $g = $g.Replace('**',  "${ph}B")
107:  $g = $g.Replace('*',   "${ph}C")
108:  $g = $g.Replace('?',   "${ph}D")
109:  $g = $g.Replace("${ph}A", '(.*/)?').Replace("${ph}B", '.*')
110:  $g = $g.Replace("${ph}C", '[^/]*').Replace("${ph}D", '[^/]')
111:  return '^' + $g + '$'
112:}
113:
114:# Compile a whole glob SET to ONE alternation regex. Compiling per-glob-per-file instead is O(files x
115:# globs): on a real 57-file promotion diff against the shipped criteria that is ~2800 compilations,
116:# and in the sh twin (where each one is a sed + grep fork) it took MINUTES and made /promote unusable.
117:# Compile once per rule group, match in one pass. Mirror of globs_union_regex in risk.sh.
118:function Get-GlobUnionRegex($Globs) {
119:  $parts = @(@($Globs) | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) } |
120:             ForEach-Object { Convert-GlobToRegex ([string]$_) })
121:  if ($parts.Count -eq 0) { return '' }
122:  return ($parts -join '|')
123:}
124:
125:# Normalize a repo-relative path for matching. Mirror of normalize_path in risk.sh.
126:function ConvertTo-NormalizedPath([string]$Path) {
127:  # Strip a leading './' only. NOT TrimStart('./') ? that trims the CHARACTER SET '.' and '/', which
128:  # would turn '.github/workflows/x.yml' into 'github/workflows/x.yml' and silently unmatch it.
129:  $p = ("$Path").Replace('\', '/')
130:  while ($p.StartsWith('./')) { $p = $p.Substring(2) }
131:  return $p
132:}
133:
134:# Does a repo-relative path match ANY of the globs? Mirror of path_matches_any in risk.sh.
135:function Test-PathMatchesAny([string]$Path, $Globs) {
136:  if ([string]::IsNullOrWhiteSpace($Path)) { return $false }
137:  $rx = Get-GlobUnionRegex $Globs
138:  if ([string]::IsNullOrEmpty($rx)) { return $false }
139:  return [regex]::IsMatch((ConvertTo-NormalizedPath $Path), $rx, 'IgnoreCase')
140:}
141:
142:# Every path in $Paths matching ANY glob in $Globs ? one compiled regex for the whole group. This is
143:# the hot path that keeps /promote fast on a real diff. Mirror of paths_matching in risk.sh.
144:function Select-MatchingPath($Paths, $Globs) {
145:  $rx = Get-GlobUnionRegex $Globs
146:  if ([string]::IsNullOrEmpty($rx)) { return @() }
147:  $re = New-Object System.Text.RegularExpressions.Regex($rx, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
148:  return @(@($Paths) | Where-Object { $re.IsMatch((ConvertTo-NormalizedPath ([string]$_))) })
149:}
150:
151:# Rank a tier. Anything unrecognized ranks as HIGH ? an unknown tier is not a low one.
152:function Get-RiskRank([string]$Tier) {
153:  switch (("$Tier").Trim().ToUpperInvariant()) {
154:    'LOW'    { return 0 }
155:    'MEDIUM' { return 1 }
156:    'HIGH'   { return 2 }
157:    default  { return 2 }
158:  }
159:}
160:
161:# The escalate-only ratchet, in code: the merged tier is the HIGHER of the two. This is what makes
162:# "the agent may confirm or raise, never lower" a property of the system rather than a promise in a
163:# prompt. Mirror of risk_tier_max in risk.sh.
164:function Merge-RiskTier([string]$A, [string]$B) {
165:  $rank = [Math]::Max((Get-RiskRank $A), (Get-RiskRank $B))
166:  return @('LOW', 'MEDIUM', 'HIGH')[$rank]
167:}
168:
169:# Parse the risk-classifier agent's verdict from its output: LOW | MEDIUM | HIGH. Mirrors
170:# Get-ReviewVerdict's fail-closed last-line rule ? only the LAST line STARTING with RISK: counts, so
171:# a mid-reasoning "RISK: LOW would be wrong here" cannot decide the outcome. Any other outcome (no
172:# text, no RISK: line, an unrecognized token) is HIGH, not NONE: unlike a review verdict there is no
173:# neutral value, and the safe direction is more human attention, not less.
174:# Mirror of risk_verdict in risk.sh.
175:# CASE-SENSITIVE (-cmatch, never -match). PowerShell's -match is case-INSENSITIVE by default while
176:# the sh twin's grep -E is not, and that divergence LOWERS tiers: the classifier is explicitly invited
177:# to add a prose note for the human, so an output ending
178:#     RISK: HIGH
179:#     risk: low blast radius here, the deterministic rules look over-escalated
180:# took the prose line as the last verdict and returned LOW on PowerShell and HIGH on bash. The
181:# contract's verdict form is uppercase; anything else is prose and must fail closed to HIGH.
182:function Get-RiskVerdict([string]$Text) {
183:  if (-not $Text) { return 'HIGH' }
184:  $line = @($Text -split "`r?`n" | Where-Object { $_ -cmatch '^\s*RISK:' }) | Select-Object -Last 1
185:  if (-not $line) { return 'HIGH' }
186:  if ($line -cmatch '^\s*RISK:\s*LOW(\s|$)')    { return 'LOW' }
187:  if ($line -cmatch '^\s*RISK:\s*MEDIUM(\s|$)') { return 'MEDIUM' }
188:  return 'HIGH'
189:}
190:
191:# Money-signal match against diff TEXT: the term must start a word, with NO constraint on what
192:# follows. NOT \b ? BSD grep in the sh twin has no \b and the twins must agree character for
193:# character, so both emulate the boundary with an explicit class.
194:#
195:# Leading boundary only, and `_` counts as a separator (class is [^A-Za-z0-9], not [^A-Za-z0-9_]).
196:# That is deliberate, and an earlier trailing-boundary version was WRONG in the dangerous direction:
197:# it missed `tax_rate`, `taxes`, `prices`, `amounts` ? inflected and snake_case forms are most of how
198:# money words actually appear in code, so the rule silently passed real money diffs as LOW.
199:# The cost is a false positive on a word that merely STARTS with a money term (`taxonomy`, `balancer`).
200:# That is the correct trade: a false HIGH costs one human glance, a false LOW auto-merges a money bug.
201:# A term mid-word (`syntax` for `tax`) still does not fire.
202:function Test-MoneySignal([string]$Text, [string]$Term) {
203:  if ([string]::IsNullOrEmpty($Text) -or [string]::IsNullOrWhiteSpace($Term)) { return $false }
204:  $t = [regex]::Escape($Term.Trim())
205:  $opts = [System.Text.RegularExpressions.RegexOptions]'IgnoreCase, Multiline'
206:  return [regex]::IsMatch($Text, "(^|[^A-Za-z0-9])$t", $opts)
207:}
208:
209:<#
210:  The deterministic classifier ? stage 1, and the only stage that can produce LOW.
211:
212:  Every criterion is computed FROM THE DIFF, so it cannot be talked around. Each rule can only
213:  raise the tier; the order below is therefore irrelevant to the result, only to the reason list.
214:
215:  -Config       the whole harness config object (reads .promotion)
216:  -Files        repo-relative paths changed in the range
217:  -ChangedLines additions + deletions across the range
218:  -AddedText    the ADDED lines of the diff (money signals are content, not paths)
219:
220:  Returns [pscustomobject]@{ Tier = 'LOW'|'MEDIUM'|'HIGH'; Reasons = string[] }.
221:  Mirror of deterministic_risk in risk.sh.
222:#>
223:function Get-DeterministicRisk {
224:  param($Config, $Files = @(), [int]$ChangedLines = 0, [string]$AddedText = '')
225:  $p        = Get-RiskProp $Config 'promotion'
226:  $files    = @($Files | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
227:  $tier     = 'LOW'
228:  $reasons  = New-Object System.Collections.Generic.List[string]
229:
230:  # Fail-closed: nothing to classify is not "low risk", it is a caller bug or a resolved-wrong range.
231:  if ($files.Count -eq 0 -and $ChangedLines -le 0) {
232:    # ASCII-only inside emitted STRINGS (comments are fine): PS 5.1 reads a BOM-less .ps1 as ANSI, so
233:    # a non-ASCII literal reaches the audit record and the PR comment as mojibake.
234:    return [pscustomobject]@{ Tier = 'HIGH'; Reasons = @('empty diff - nothing to classify (fail-closed)') }
235:  }
236:
237:  # One compiled regex per rule group over the whole file list ? never per (file, glob) pair.
238:  foreach ($f in (Select-MatchingPath $files $script:RiskSelfGovernGlobs)) {
239:    $tier = Merge-RiskTier $tier 'HIGH'; $reasons.Add("self-governance: $f (policy, guardrails, or CI)")
240:  }
241:  foreach ($f in (Select-MatchingPath $files (Get-RiskProp $p 'alwaysHuman'))) {
242:    $tier = Merge-RiskTier $tier 'HIGH'; $reasons.Add("alwaysHuman path: $f")
243:  }
244:  foreach ($term in @(Get-RiskProp $p 'moneySignals')) {
245:    if (Test-MoneySignal $AddedText ([string]$term)) {
246:      $tier = Merge-RiskTier $tier 'HIGH'; $reasons.Add("money signal '$term' in added lines")
247:    }
248:  }
249:
250:  $criteria = Get-RiskProp $p 'criteria'
251:  $maxLines = Get-RiskProp $criteria 'maxChangedLines'
252:  if ($null -ne $maxLines -and $ChangedLines -ge [int]$maxLines) {
253:    $tier = Merge-RiskTier $tier 'MEDIUM'; $reasons.Add("$ChangedLines changed lines (limit $maxLines)")
254:  }
255:  $escalate = Get-RiskProp $criteria 'escalatePaths'
256:  if ($null -ne $escalate) {
257:    foreach ($cat in $escalate.PSObject.Properties) {
258:      # First match only: the category is the finding, not each file in it.
259:      $hit = @(Select-MatchingPath $files $cat.Value) | Select-Object -First 1
260:      if ($hit) { $tier = Merge-RiskTier $tier 'MEDIUM'; $reasons.Add("$($cat.Name): $hit") }
261:    }
262:  }
263:
264:  if ($reasons.Count -eq 0) { $reasons.Add('no escalation criterion tripped') }
265:  return [pscustomobject]@{ Tier = $tier; Reasons = @($reasons) }
266:}
267:
268:<#
269:  The promotion decision ? AUTO (auto-approve + auto-merge) or HUMAN (escalate, never merge).
270:
271:  Fail-closed and ordered so the strongest refusals are evaluated first, BEFORE any config is
272:  consulted. In particular the prod refusal does not read promotion.prod.autoMerge at all: the
273:  schema's `const: false` protects repos that validate their config in CI, and this line protects
274:  the ones that do not.
275:
276:  Takes the deterministic tier AND the classifier's verdict as SEPARATE arguments and computes their
277:  max() itself (the escalate-only merge) so a caller cannot substitute a single hand-picked tier.
278:
279:  Returns [pscustomobject]@{ Decision = 'AUTO'|'HUMAN'; Reason = string }.
280:  Mirror of promotion_decision in risk.sh.
281:#>
282:<#
283:  Shape-validate the promotion block before ANY of it is trusted.
284:
285:  Without this, every degenerate shape SKIPS a rule instead of escalating ? i.e. the block fails
286:  OPEN, which contradicts this file's own fail-closed contract. Three real cases, all of which
287:  reached AUTO before this gate existed:
288:   - `preconditions` absent entirely (schema-valid; /harness-prune may trim it) => a red gate, no
289:     review SHIP and no e2e evidence all passed, and the audit string still read "all preconditions
290:     met";
291:   - `alwaysHuman` / `moneySignals` written as a scalar instead of an array (a plausible hand-edit)
292:     => the whole money rule silently evaluated to "no match", so a payments diff classified LOW;
293:   - `enabled: "false"` as a STRING => PowerShell coerces the non-empty string to $true, so the
294:     master switch read as ON.
295:
296:  Anything not exactly right returns a reason and the caller refuses. Mirror of
297:  promotion_config_shape in risk.sh.
298:#>
299:function Test-PromotionConfigShape($Promotion) {
300:  if ($null -eq $Promotion) { return 'promotion block is absent' }
301:
302:  # Strictly boolean: a stringly-typed 'false'/'no'/'off' must never read as ON.
303:  if (-not (Test-RiskPropIsBool $Promotion 'enabled')) {
304:    return "promotion.enabled is not a boolean (got '$(Get-RiskProp $Promotion 'enabled')')"
305:  }
306:
307:  foreach ($key in @('alwaysHuman', 'moneySignals')) {
308:    if (-not (Test-RiskPropPresent $Promotion $key)) { return "promotion.$key is absent" }
309:    if (-not (Test-RiskPropIsArray $Promotion $key)) { return "promotion.$key is not an array" }
310:    if ((Get-RiskPropCount $Promotion $key) -eq 0)   { return "promotion.$key is empty" }
311:  }
312:
313:  $pre = Get-RiskProp $Promotion 'preconditions'
314:  if ($null -eq $pre) { return 'promotion.preconditions is absent' }
315:  foreach ($key in @('gateGreen', 'reviewShip', 'e2eEvidence')) {
316:    if (-not (Test-RiskPropPresent $pre $key)) { return "promotion.preconditions.$key is absent" }
317:    if (-not (Test-RiskPropIsBool $pre $key))  { return "promotion.preconditions.$key is not a boolean" }
318:  }
319:
320:  $criteria = Get-RiskProp $Promotion 'criteria'
321:  if ((Test-RiskPropPresent $criteria 'maxChangedLines') -and -not (Test-RiskPropIsInteger $criteria 'maxChangedLines')) {
322:    # Both twins compare it arithmetically; a fractional value diverges across shells (and in bash the
323:    # compare errors out and silently SKIPS the size rule).
324:    return "promotion.criteria.maxChangedLines is not an integer (got '$(Get-RiskProp $criteria 'maxChangedLines')')"
325:  }
326:  return ''   # well-formed
327:}
328:
329:function Get-PromotionDecision {
330:  param($Config, [string]$Environment,
331:        [string]$DeterministicTier, [string]$ClassifierTier,
332:        [bool]$GateGreen = $false, [bool]$ReviewShip = $false, [bool]$E2EEvidence = $false,
333:        [bool]$ReviewerConfigured = $false)
334:  # Named $envName, not $env: `$env` reads as the environment-variable drive in PowerShell and the
335:  # shadowing is a trap for the next reader.
336:  $envName = ("$Environment").Trim().ToLowerInvariant()
337:  # The escalate-only merge lives HERE, not in the caller: the decision takes BOTH the deterministic
338:  # tier and the classifier's verdict and computes max() itself, so no caller can hand it a single
339:  # pre-merged (lower) tier and bypass the classifier's escalation. Either input being unknown/absent
340:  # ranks HIGH (Get-RiskRank default), so a garbage or omitted classifier tier fails CLOSED to HUMAN.
341:  $t       = Merge-RiskTier $DeterministicTier $ClassifierTier
342:
343:  if ($envName -ne 'staging' -and $envName -ne 'prod') {
344:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = "unknown environment '$Environment'" }
345:  }
346:  # Unconditional, config-independent, and first: prod promotion is a human action, always.
347:  if ($envName -eq 'prod') {
348:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'prod promotion is always a human action' }
349:  }
350:
351:  $p = Get-RiskProp $Config 'promotion'
352:
353:  # Shape gate BEFORE any rule is trusted: a malformed block must refuse, never skip a rule.
354:  $shapeErr = Test-PromotionConfigShape $p
355:  if ($shapeErr) {
356:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = "promotion config not well-formed: $shapeErr" }
357:  }
358:
359:  if ($true -ne (Get-RiskProp $p 'enabled')) {
360:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'promotion.enabled is not true (report-only)' }
361:  }
362:
363:  # Preconditions gate the AUTO path but are not risk: a HIGH-risk change and an unreviewed change
364:  # both go to a human, for different reasons, and the audit record must say which.
365:  $pre = Get-RiskProp $p 'preconditions'
366:  if ($true -eq (Get-RiskProp $pre 'gateGreen')   -and -not $GateGreen)   {
367:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'precondition unmet: project gate is not green' }
368:  }
369:  if ($true -eq (Get-RiskProp $pre 'reviewShip')  -and -not $ReviewShip)  {
370:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'precondition unmet: no fresh-context review SHIP for this range' }
371:  }
372:  if ($true -eq (Get-RiskProp $pre 'e2eEvidence') -and -not $E2EEvidence) {
373:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'precondition unmet: no end-to-end evidence for this range' }
374:  }
375:
376:  $threshold = Get-RiskProp (Get-RiskProp $p 'staging') 'autoMergeAtOrBelow'
377:  if (("$threshold").Trim().ToLowerInvariant() -ne 'low') {
378:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'staging.autoMergeAtOrBelow is not "low" (report-only)' }
379:  }
380:  if ($t -ne 'LOW') {
381:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = "risk tier $t exceeds the staging auto-merge threshold" }
382:  }
383:  # Last gate before AUTO, and fail-closed by default ($false): GitHub rejects self-approval, so the
384:  # auto-merge is only reachable when a SEPARATE reviewer identity is available to approve the PR. The
385:  # caller (/promote) computes this bool from promotion.reviewer.tokenEnv -> a non-empty token whose
386:  # gh identity differs from the PR author; it CANNOT be derived here (env + gh are the caller's), so
387:  # an omitted/unresolvable reviewer arrives as $false and drops to HUMAN, never to the merge path.
388:  if (-not $ReviewerConfigured) {
389:    return [pscustomobject]@{ Decision = 'HUMAN'; Reason = 'no separate reviewer identity configured (promotion.reviewer.tokenEnv unset/empty or equals the PR author); GitHub rejects self-approval' }
390:  }
391:  return [pscustomobject]@{ Decision = 'AUTO'; Reason = 'LOW risk, all preconditions met, separate reviewer identity available, target staging' }
392:}
393:
394:<#
395:  Collect the raw diff signals for a range. Thin by design ? everything decision-shaped lives in the
396:  pure functions above so the self-tests can drive them without a git fixture.
397:
398:  Returns [pscustomobject]@{ Files = string[]; ChangedLines = int; AddedText = string }.
399:  AddedText holds only ADDED lines with the leading '+' stripped, and excludes the '+++' file
400:  headers (else every diff would "contain" its own paths and money-signal on them).
401:  Mirror of diff_signals in risk.sh.
402:#>
403:function Get-DiffSignals([string]$BaseRef, [string]$HeadRef = 'HEAD') {
404:  $files = @(& git diff --name-only "$BaseRef" "$HeadRef" 2>$null | Where-Object { $_ })
405:  $lines = 0
406:  foreach ($row in @(& git diff --numstat "$BaseRef" "$HeadRef" 2>$null)) {
407:    $cols = "$row" -split "`t"
408:    if ($cols.Count -ge 2) {
409:      # '-' in a numstat column means a binary file: no line count to add, but the file still counts.
410:      if ($cols[0] -match '^\d+$') { $lines += [int]$cols[0] }
411:      if ($cols[1] -match '^\d+$') { $lines += [int]$cols[1] }
412:    }
413:  }
414:  $added = @(& git diff --unified=0 "$BaseRef" "$HeadRef" 2>$null |
415:             Where-Object { $_ -match '^\+' -and $_ -notmatch '^\+\+\+' } |
416:             ForEach-Object { $_.Substring(1) })
417:  return [pscustomobject]@{ Files = $files; ChangedLines = $lines; AddedText = ($added -join "`n") }
418:}

