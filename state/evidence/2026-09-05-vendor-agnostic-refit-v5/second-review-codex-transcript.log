       "properties": {
         "enabled": { "type": "boolean", "description": "Master switch. false => /promote still classifies and REPORTS, but always returns HUMAN and never touches GitHub. Default false." },
         "staging": {
           "type": "object",
           "description": "The lower environment — the only one automation may merge into.",
           "properties": {
             "branch": { "type": "string", "description": "Target branch for a staging promotion, e.g. 'staging' or 'develop'." },
